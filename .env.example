# Copy to .env for local dev (`npm run dev` loads it). Never commit real secrets.

NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# MongoDB. "memory" starts an in-process mongodb-memory-server (dev/test only, data lost on restart).
# Production: an Atlas URI, e.g. mongodb+srv://user:pass@cluster.example.mongodb.net
MONGODB_URI=memory
MONGODB_DB=shadeloop

# Number of reverse proxies in front of the app (Render: 1). Used for rate-limit client IPs.
TRUST_PROXY=0
RATE_LIMIT_PER_MIN=120

# AI is optional. none | ollama | openai
AI_PROVIDER=none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
# OpenAI-compatible provider (required only when AI_PROVIDER=openai)
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=1

# Place discovery. live = OpenStreetMap Overpass (+ SerpApi if key set). fixture = labelled sample places for demos.
DISCOVERY_MODE=live
SERPAPI_KEY=
OVERPASS_URL=https://overpass-api.de/api/interpreter
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
HTTP_TIMEOUT_MS=20000

# Optional. Sentry agent tracing: planner, tool and model spans (counts and model names only) plus 5xx errors.
SENTRY_DSN=
