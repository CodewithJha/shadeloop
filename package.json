{
  "name": "shadeloop",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source AI outdoor field companion. Go outside. Discover more. Make every walk count.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "build": "npm run build -w web",
    "start": "node server/src/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc -p server && tsc -p web",
    "test": "npm test -w server && npm test -w web",
    "openapi": "node server/src/openapi.ts > docs/openapi.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
